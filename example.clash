function (main)
memory.start{
	print(c)//в данном случае просто выдаст ошибку из за перменной без значения 
}
memory.load (main)
memory.out 


###########################################
#
#
#правильный вид 
########################################## 
function (print){//переносим фигурную скобку на функцию 
	print(c)
}
function (zapis)
memory.start{//тут уже запись сразу без ожидания 
	c = 12//объявление переменной 
	memory.start (print)// после объявления переменной загрузка той функции 
}
memory.load(zapis,print) 
memory.out 

